# Copie para .env e ajuste. Nunca versione o .env.
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=stockflow
POSTGRES_DB=stockflow
POSTGRES_PORT=5433

DATABASE_URL=postgresql+psycopg://stockflow:stockflow@localhost:5433/stockflow
TEST_DATABASE_URL=postgresql+psycopg://stockflow:stockflow@localhost:5433/stockflow_test

# Assina os tokens de login (mínimo 32 caracteres). Gere uma: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave-por-uma-gerada-com-secrets
# Validade do login, em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Senha dos usuários de demonstração (admin@, operador@ e leitor@stockflow.dev)
DEMO_PASSWORD=stockflow123

# Fuso dos relatórios e filtros por dia
TIMEZONE=America/Sao_Paulo
